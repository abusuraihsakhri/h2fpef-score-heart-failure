{
  "openapi": "3.1.0",
  "info": {
    "title": "H2Fpef Score Heart Failure API",
    "description": "H2FPEF score API and separate optional generic auditing endpoints. Not a medical device.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational counters; not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic test-provider mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate the six-component H2FPEF point score",
        "description": "Requires all six clinical measurements; returns point breakdown and score completeness information.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bmi",
                  "num_antihypertensives",
                  "af_present",
                  "pasp_mmhg",
                  "age",
                  "e_e_prime"
                ],
                "properties": {
                  "bmi": {
                    "type": "number"
                  },
                  "num_antihypertensives": {
                    "type": "integer"
                  },
                  "af_present": {
                    "type": "boolean"
                  },
                  "pasp_mmhg": {
                    "type": "number"
                  },
                  "age": {
                    "type": "number"
                  },
                  "e_e_prime": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "H2FPEF score and component breakdown"
          },
          "422": {
            "description": "Invalid or incomplete clinical measurements"
          }
        }
      }
    }
  }
}
